            buildSentenceCaseMessage('update_success', '{{model}}'),
            Response::HTTP_OK
        );
    }

    public function delete(Delete{{model}}Request $request)
    {
        $result = $this->{{modelVariable}}Service->delete{{model}}($request->validated()['id']);
        if (isset($result['action_status']) && $result['action_status'] === 'fail') {
            return $this->errorResponse(
